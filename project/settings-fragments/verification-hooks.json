{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write(*.tsx)",
        "hooks": [
          { "type": "command", "command": "npx tsc --noEmit" },
          { "type": "command", "command": "npm run lint:fix" }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/build-checker.sh\"" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "echo 'Context will be compacted - check dev docs'" }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-self-check.sh\"" }
        ]
      }
    ]
  }
}
