{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write(*.tsx)",
        "hooks": [
          { "type": "command", "command": "npx tsc --noEmit" },
          { "type": "command", "command": "npm run lint:fix" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "echo 'Context will be compacted - check dev docs'" }
        ]
      }
    ]
  }
}
